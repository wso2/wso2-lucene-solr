<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.wso2</groupId>
    <artifactId>wso2</artifactId>
    <version>1.3</version>
  </parent>
  <groupId>org.apache.lucene-solr</groupId>
  <artifactId>lucene-solr-parent</artifactId>
  <version>8.11.4-wso2v5-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>WSO2 Lucene / Solr fork</name>

  <scm>
    <url>https://github.com/wso2/wso2-lucene-solr.git</url>
    <developerConnection>scm:git:https://github.com/wso2/wso2-lucene-solr.git</developerConnection>
    <connection>scm:git:https://github.com/wso2/wso2-lucene-solr.git</connection>
    <tag>HEAD</tag>
  </scm>

  <build>
    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.0.0</version>

        <dependencies>
          <dependency>
            <groupId>org.apache.ivy</groupId>
            <artifactId>ivy</artifactId>
            <version>2.5.0</version>
          </dependency>
        </dependencies>

        <executions>
          <execution>
            <id>ant-compile</id>
            <phase>compile</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <taskdef name="ivy" classname="org.apache.ivy.ant.IvyConfigure" classpathref="maven.plugin.classpath" />
                <ant antfile="build.xml" target="compile">
                  <property name="build.compiler" value="extJavac" />
                  <property name="version" value="${project.version}" />
                  <property name="ivy_install_path" location="${project.build.directory}" />
                </ant>
              </target>
            </configuration>
          </execution>

          <execution>
            <id>ant-jar</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <taskdef name="ivy" classname="org.apache.ivy.ant.IvyConfigure" classpathref="maven.plugin.classpath" />
                <ant antfile="build.xml" target="jar">
                  <property name="build.compiler" value="extJavac" />
                  <property name="version" value="${project.version}" />
                  <property name="ivy_install_path" location="${project.build.directory}" />
                </ant>
              </target>
            </configuration>
          </execution>

          <execution>
            <id>ant-test</id>
            <phase>test</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <skip>${maven.test.skip}</skip>
              <target>
                <taskdef name="ivy" classname="org.apache.ivy.ant.IvyConfigure" classpathref="maven.plugin.classpath" />
                <ant antfile="build.xml" target="test">
                  <property name="build.compiler" value="extJavac" />
                  <property name="version" value="${project.version}" />
                  <property name="ivy_install_path" location="${project.build.directory}" />
                </ant>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <executions>
          <execution>
            <id>deploy-solr-core</id>
            <phase>deploy</phase>
            <goals>
              <goal>deploy-file</goal>
            </goals>
            <configuration>
              <file>${project.basedir}/solr/build/solr-core/solr-core-${project.version}.jar</file>
              <groupId>org.apache.lucene-solr</groupId>
              <artifactId>solr-core</artifactId>
              <version>${project.version}</version>
              <packaging>jar</packaging>
              <url>${project.distributionManagement.snapshotRepository.url}</url>
              <repositoryId>${project.distributionManagement.snapshotRepository.id}</repositoryId>
            </configuration>
          </execution>
          <execution>
            <id>deploy-solr-solrj</id>
            <phase>deploy</phase>
            <goals>
              <goal>deploy-file</goal>
            </goals>
            <configuration>
              <file>${project.basedir}/solr/build/solr-solrj/solr-solrj-${project.version}.jar</file>
              <groupId>org.apache.lucene-solr</groupId>
              <artifactId>solr-solrj</artifactId>
              <version>${project.version}</version>
              <packaging>jar</packaging>
              <url>${project.distributionManagement.snapshotRepository.url}</url>
              <repositoryId>${project.distributionManagement.snapshotRepository.id}</repositoryId>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <profile>
      <id>wso2-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <executions>
              <execution>
                <id>deploy-solr-core</id>
                <phase>deploy</phase>
                <goals>
                  <goal>deploy-file</goal>
                </goals>
                <configuration>
                  <file>${project.basedir}/solr/build/solr-core/solr-core-${project.version}.jar</file>
                  <groupId>org.apache.lucene-solr</groupId>
                  <artifactId>solr-core</artifactId>
                  <version>${project.version}</version>
                  <packaging>jar</packaging>
                  <url>${project.distributionManagement.repository.url}</url>
                  <repositoryId>${project.distributionManagement.repository.id}</repositoryId>
                </configuration>
              </execution>
              <execution>
                <id>deploy-solr-solrj</id>
                <phase>deploy</phase>
                <goals>
                  <goal>deploy-file</goal>
                </goals>
                <configuration>
                  <file>${project.basedir}/solr/build/solr-solrj/solr-solrj-${project.version}.jar</file>
                  <groupId>org.apache.lucene-solr</groupId>
                  <artifactId>solr-solrj</artifactId>
                  <version>${project.version}</version>
                  <packaging>jar</packaging>
                  <url>${project.distributionManagement.repository.url}</url>
                  <repositoryId>${project.distributionManagement.repository.id}</repositoryId>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <properties>
    <version>${project.version}</version>
  </properties>
</project>
